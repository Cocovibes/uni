# ─── Datos personales: NO se publican ───────────────────────────────
# Los exámenes y asignaturas reales son tuyos. El repo solo lleva la
# estructura y las plantillas; en Ejemplos/ hay una muestra de cada uno.
/Exámenes/*
/Asignaturas/*
!/Exámenes/.gitkeep
!/Asignaturas/.gitkeep

# Índice de materiales: lo genera `uni sync` a partir de TUS carpetas de
# curso, así que su contenido es tan personal como ellas.
/Materiales.md

# Diario, adjuntos y papelera del vault
/Diario/
/Adjuntos/
/.trash/

# Calendario generado (se reconstruye con `uni sync`)
/out/

# rclone escribe aquí el hash del fichero de filtros para saber si ha cambiado.
# Es estado local suyo, no configuración.
/sistema/drive.filtros.md5

# ─── Estado local de Obsidian ───────────────────────────────────────
# workspace.json se reescribe cada vez que mueves un panel.
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/.obsidian/graph.json
/.obsidian/appearance.json

# El código de los plugins no se redistribuye: lo baja instalar.sh
# desde el repo canónico de cada uno, verificando el id del manifest.
/.obsidian/plugins/

__pycache__/
*.pyc
