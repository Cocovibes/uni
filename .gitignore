# ─── Datos personales: NO se publican ───────────────────────────────
# Los exámenes y asignaturas reales son tuyos. El repo solo lleva la
# estructura y las plantillas; en Ejemplos/ hay una muestra de cada uno.
/Exámenes/*
/Asignaturas/*
!/Exámenes/.gitkeep
!/Asignaturas/.gitkeep

# Nodos del grafo (curso y cuatrimestre): los genera `uni sync` a partir de
# TUS carpetas de curso, así que son tan personales como ellas.
/Cursos/

# Diario, adjuntos y papelera del vault
/Diario/
/Adjuntos/
/.trash/

# Calendario generado (se reconstruye con `uni sync`).
# EXCEPCIÓN: uni-ull.ics SÍ se publica. Son las fechas oficiales de la ESIT,
# que ya son públicas, y publicarlo es lo que permite SUSCRIBIRSE desde el
# iPhone (Ajustes → Calendario → Añadir calendario suscrito).
# uni-estudio.ics NO se publica NUNCA: sale de Exámenes/ y Asignaturas/, que
# están ignorados justamente por ser personales.
/out/*
!/out/uni-ull.ics

# rclone escribe aquí el hash del fichero de filtros para saber si ha cambiado.
# Es estado local suyo, no configuración.
/sistema/drive.filtros.md5

# ─── Estado local de Obsidian ───────────────────────────────────────
# workspace.json se reescribe cada vez que mueves un panel.
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/.obsidian/graph.json
/.obsidian/appearance.json

# El código de los plugins no se redistribuye: lo baja instalar.sh
# desde el repo canónico de cada uno, verificando el id del manifest.
/.obsidian/plugins/

__pycache__/
*.pyc
