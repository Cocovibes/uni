[Unit]
Description=Comprueba una vez por semana si la ESIT movió algún examen

[Timer]
# Lunes a las 09:00. El calendario del curso se publica entero de una vez, así
# que esto no busca exámenes nuevos: busca RECTIFICACIONES (una fecha movida,
# un aula cambiada). Semanal sobra para eso y no castiga la red.
OnCalendar=Mon *-*-* 09:00
# Si el portátil estaba apagado el lunes, salta al encender.
Persistent=true
AccuracySec=5min
# Que no salgan todos los timers clavados a la vez al arrancar.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
