[Unit]
Description=Plan de estudio de hoy (notificación)
After=graphical-session.target

[Service]
Type=oneshot
# notify-send necesita el bus de sesión; systemd --user no lo hereda solo.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
# Por el wrapper y no por uni.py directamente: ahí está el calendario destino.
ExecStart=%h/.local/bin/uni sync
ExecStart=%h/.local/bin/uni notificar
